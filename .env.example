# --- Required in production ---
# Secret used to sign admin session JWTs (generate: openssl rand -base64 32)
JWT_SECRET=replace-me-with-a-long-random-string

# Public base URL of the site, used for absolute canonical/OG/sitemap urls
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Serverless (Vercel): REQUIRED for durable dashboard/password changes.
# Use a pooled PostgreSQL URL with SSL. Optional on local/Docker with a
# persistent data/ volume; do not commit the real value to Git.
DATABASE_URL=

# Serverless (Vercel): REQUIRED for durable media + downloadable builds.
# Connect a public Vercel Blob store to the project to set this automatically.
BLOB_READ_WRITE_TOKEN=

# Next.js sets NODE_ENV automatically for dev/build/start; don't override it.

# --- Optional: contact form email notifications ---
# If SMTP is configured, contact submissions are also emailed to the site owner.
# If omitted, submissions are saved to the configured JSON/Postgres store.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# Default seeded admin credentials (only use to log in once, then change it!):
#   email:    dev.abhishek.ap11@gmail.com
#   password: Admin@12345
