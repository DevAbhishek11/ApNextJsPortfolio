# --- Required in production ---
# Secret used to sign admin session JWTs (generate: openssl rand -base64 32)
JWT_SECRET=replace-me-with-a-long-random-string

# Public base URL of the site, used for absolute canonical/OG/sitemap urls
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Standard Node env
NODE_ENV=development

# --- Optional: contact form email notifications ---
# If SMTP is configured, contact submissions are also emailed to the site owner.
# If omitted, submissions are simply saved to data/messages.json (no error).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# Default seeded admin credentials (only use to log in once, then change it!):
#   email:    dev.abhishek.ap11@gmail.com
#   password: Admin@12345
